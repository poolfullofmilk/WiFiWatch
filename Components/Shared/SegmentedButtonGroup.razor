@typeparam TValue

@* Button Group *@
<MudButtonGroup Size="Size.Small"
                Class="mx-1"
                Style="border-radius:var(--mud-default-borderradius)"
                OverrideStyles="false">
    @foreach (var option in Options)
    {
        @if (string.IsNullOrEmpty(option.Icon))
        {
            @* Text Button *@
            <MudButton Variant="@(IsSelected(option.Value) ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Info"
                       Size="Size.Small"
                       OnClick="@(() => OnOptionSelectedAsync(option.Value))">
                @option.Label
            </MudButton>
        }
        else
        {
            @* Icon Button *@
            <MudIconButton Variant="@(IsSelected(option.Value) ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Info"
                           Size="Size.Small"
                           Icon="@option.Icon"
                           OnClick="@(() => OnOptionSelectedAsync(option.Value))" />
        }
    }
</MudButtonGroup>
