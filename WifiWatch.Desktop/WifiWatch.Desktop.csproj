<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>WifiWatch.Desktop</RootNamespace>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DebugType>embedded</DebugType>
        <Description>Watches Wi-Fi Channel, Signal And Ping And Logs Every Change</Description>
        <Copyright>Copyright 2026</Copyright>
        <Version>1.5</Version>
        <AssemblyTitle>Wifi Watch</AssemblyTitle>
        <Product>Wifi Watch</Product>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AssemblyName>WifiWatch_v$(Version)</AssemblyName>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>
    <Target
        Name="BundleWebRoot"
        BeforeTargets="_ComputeFilesToBundle"
        DependsOnTargets="CopyStaticWebAssetsToPublishDirectory"
    >
        <ItemGroup>
            <WebRootFile Include="$(PublishDir)wwwroot\**" />
            <ResolvedFileToPublish
                Include="@(WebRootFile)"
                RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
            />
        </ItemGroup>
    </Target>
    <Target Name="RemoveLooseWebRoot" AfterTargets="Publish">
        <RemoveDir Directories="$(PublishDir)wwwroot" />
        <Delete Files="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
    </Target>
    <ItemGroup>
        <Using Remove="System.Drawing" />
        <Using Remove="System.Windows.Forms" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
        <PackageReference
            Include="Microsoft.AspNetCore.Components.WebView.Wpf"
            Version="10.0.110"
        />
        <PackageReference
            Include="Microsoft.EntityFrameworkCore.Design"
            Version="10.0.12"
            Condition="'$(Configuration)' == 'Debug'"
        >
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MudBlazor" Version="9.11.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\WifiWatch.Data\WifiWatch.Data.csproj" />
        <ProjectReference Include="..\WifiWatch.Services\WifiWatch.Services.csproj" />
    </ItemGroup>
</Project>
