@* Incident Dialog *@
<MudDialog>

    <TitleContent>
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="3">
            <MudIcon Icon="@EventKindColors.IconFor(Event.Severity)"
                     Color="@EventKindColors.For(Event.Kind, Event.Severity)" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Event.Kind.ToLabel()</MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @TimeRange
                </MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4"
                  Style="max-width:720px">
            <MudText Typo="Typo.body1"
                     Class="selectable-text">
                @Event.Message
            </MudText>
            @if (DetailLines.Count > 0)
            {
                @* Detail Table *@
                <MudSimpleTable Dense
                                Bordered
                                Outlined
                                Elevation="0"
                                Class="rounded-inner">
                    <tbody>
                        @foreach (var (label, value) in DetailLines)
                        {
                            <tr>
                                <td class="mud-text-secondary">@label</td>
                                <td class="selectable-text">@value</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            @if (Details.Trace is { Count: > 0 } hops)
            {
                @* Trace Table *@
                <MudSimpleTable Dense
                                Striped
                                Bordered
                                Outlined
                                Elevation="0"
                                Class="rounded-inner">
                    <thead>
                        <tr>
                            <th>Hop</th>
                            <th>Address</th>
                            <th>Name</th>
                            <th>Loss</th>
                            <th>Average</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hop in hops)
                        {
                            <tr>
                                <td>@hop.Number</td>
                                <td>@(hop.Address ?? "No Answer")</td>
                                <td>@(hop.Name ?? "-")</td>
                                <td>@($"{hop.LossPercent:0}%")</td>
                                <td>@Formatter.FormatNumber(hop.AverageMilliseconds, "ms")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row
                  Spacing="4"
                  Class="px-3 py-2"
                  Style="width:100%">
            @if (FixTarget is { } fixTarget)
            {
                @* Fix Button *@
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Rounded.Build"
                           OnClick="() => QuickActions.Open(fixTarget)">
                    @QuickActions.Describe(fixTarget)
                </MudButton>
            }
            <MudSpacer />
            @* Close Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       OnClick="Close">
                Close
            </MudButton>
        </MudStack>
    </DialogActions>

</MudDialog>
