@using ApexCharts
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

<MudStack Spacing="6">
    @* Stats Toolbar *@
    <MudStack Row
              Justify="Justify.Center"
              AlignItems="AlignItems.Center"
              Spacing="3">
        <MudElement HtmlTag="div"
                    Style="width:340px">
            @* Stats Range *@
            <MudDateRangePicker @ref="_rangePicker"
                                DateRange="_range"
                                DateRangeChanged="SelectRangeAsync"
                                MaxDate="DateTime.Today"
                                DateFormat="yyyy-MM-dd"
                                Color="Color.Info"
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense"
                                AutoClose>
                <PickerActions>
                    @* Today Button *@
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="() => ApplyPresetAsync(1)">
                        Today
                    </MudButton>
                    @* Week Button *@
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="() => ApplyPresetAsync(7)">
                        7 Days
                    </MudButton>
                    @* Month Button *@
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="() => ApplyPresetAsync(30)">
                        30 Days
                    </MudButton>
                </PickerActions>
            </MudDateRangePicker>
        </MudElement>
        @* Speed Test Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.Speed"
                   Disabled="Monitor.Status.IsSpeedTesting"
                   OnClick="RunSpeedTestAsync">
            @(Monitor.Status.IsSpeedTesting ? "Testing Speed" : "Speed Test")
        </MudButton>
        @* Report Button *@
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.Description"
                   Disabled="_isReporting"
                   OnClick="SaveReportAsync">
            Report
        </MudButton>
    </MudStack>
    <MudGrid>

        @* Ping Chart *@
        <MudItem xs="12"
                 md="8">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>@($"Ping {BucketTitle}")</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="280px"
                                 Style="border-radius:10px" />
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_pingOptions"
                               Height="@("280")"
                               OnDataPointSelection="ShowMinutesAsync">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_routerPingPoints"
                                         Name="Router"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_internetPingPoints"
                                         Name="Internet"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_dnsPoints"
                                         Name="DNS"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Eviction Chart *@
        <MudItem xs="12"
                 md="4">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>@($"DFS Evictions {BucketTitle}")</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="280px"
                                 Style="border-radius:10px" />
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_evictionOptions"
                               Height="@("280")">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_evictionPoints"
                                         Name="Evictions"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Jitter Chart *@
        <MudItem xs="12"
                 md="6">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>@($"Jitter {BucketTitle}")</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="240px"
                                 Style="border-radius:10px" />
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_jitterOptions"
                               Height="@("240")"
                               OnDataPointSelection="ShowMinutesAsync">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_routerJitterPoints"
                                         Name="Router"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_internetJitterPoints"
                                         Name="Internet"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Loss Chart *@
        <MudItem xs="12"
                 md="6">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>@($"Packet Loss {BucketTitle}")</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="240px"
                                 Style="border-radius:10px" />
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_lossOptions"
                               Height="@("240")"
                               OnDataPointSelection="ShowMinutesAsync">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_routerLossPoints"
                                         Name="Router"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_internetLossPoints"
                                         Name="Internet"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Timeline Chart *@
        <MudItem xs="12">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>Incident Timeline</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="200px"
                                 Style="border-radius:10px" />
                }
                else if (_timelineBars.Count == 0)
                {
                    <MudText Typo="Typo.body2"
                             Class="mx-2 mud-text-secondary">
                        No Incidents In This Range
                    </MudText>
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="TimelineBar"
                               Options="_timelineOptions"
                               Height="@TimelineHeight">
                        <ApexRangeSeries TItem="TimelineBar"
                                         Items="_timelineBars"
                                         Name="Incidents"
                                         XValue="@(bar => bar.Label)"
                                         YMinValue="@(bar => bar.Start)"
                                         YMaxValue="@(bar => bar.End)"
                                         DataPointMutator="ColorBar" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Heatmap Chart *@
        <MudItem xs="12"
                 md="8">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>Incidents By Weekday And Hour</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="280px"
                                 Style="border-radius:10px" />
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_heatmapOptions"
                               Height="@("280")">
                        @foreach (var row in _heatmapRows)
                        {
                            <ApexPointSeries TItem="ChartPoint"
                                             Items="row.Points"
                                             Name="@row.Name"
                                             SeriesType="SeriesType.Heatmap"
                                             XValue="@(point => point.Label)"
                                             YValue="@(point => point.Value)" />
                        }
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Speed Chart *@
        <MudItem xs="12"
                 md="4">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel mud-height-full">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>Speed Tests</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="280px"
                                 Style="border-radius:10px" />
                }
                else if (_downloadPoints.Count == 0)
                {
                    <MudText Typo="Typo.body2"
                             Class="mx-2 mud-text-secondary">
                        No Speed Tests In This Range
                    </MudText>
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_speedOptions"
                               Height="@("280")">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_downloadPoints"
                                         Name="Download"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_uploadPoints"
                                         Name="Upload"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                    </ApexChart>
                    <MudText Typo="Typo.body2"
                             Class="mx-2 mt-3">
                        @_lastSpeedTest
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        @* Neighbor Chart *@
        <MudItem xs="12"
                 md="8">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>Nearby Networks Per Block</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                                 Height="280px"
                                 Style="border-radius:10px" />
                }
                else
                {
                    <ApexChart @key="_renderKey"
                               TItem="ChartPoint"
                               Options="_neighborOptions"
                               Height="@("280")">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="_neighborPoints"
                                         Name="Networks"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(point => point.Label)"
                                         YValue="@(point => point.Value)" />
                    </ApexChart>
                }
            </MudPaper>
        </MudItem>

        @* Channel Advice *@
        <MudItem xs="12"
                 md="4">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel mud-height-full">
                <MudText Typo="Typo.subtitle1"
                         Class="mx-2 mb-3">
                    <b>Channel Advice</b>
                </MudText>
                @if (_isLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Text"
                                 Animation="Animation.Wave" />
                }
                else
                {
                    <MudStack Spacing="3"
                              Class="mx-2">
                        <MudText Typo="Typo.body1">
                            @_channelAdvice
                        </MudText>
                        @* Advice Chips *@
                        <MudStack Row
                                  Wrap="Wrap.Wrap"
                                  Spacing="1">
                            <ActionChip Icon="@Icons.Material.Rounded.Radar"
                                        Text="@($"{_evictionCount} Evictions")"
                                        Color="@(_evictionCount > 0 ? Color.Warning : Color.Success)"
                                        Target="@Monitor.Status.RouterAdminUrl" />
                            @if (_dfsPercent is { } dfsPercent)
                            {
                                <ActionChip Icon="@Icons.Material.Rounded.PieChart"
                                            Text="@($"{dfsPercent:0}% On DFS")"
                                            Color="Color.Info" />
                            }
                            @if (_ownAirtimePercent is { } airtimePercent)
                            {
                                <ActionChip Icon="@Icons.Material.Rounded.DataUsage"
                                            Text="@($"Airtime Busy {airtimePercent}%")"
                                            Color="@(airtimePercent >= BusyAirtimePercent ? Color.Warning : Color.Success)" />
                            }
                            @if (Monitor.Status.DfsFreeAtUtc is { } freeAtUtc)
                            {
                                <ActionChip Icon="@Icons.Material.Rounded.LockClock"
                                            Text="@($"DFS Free At {Formatter.FormatLocal(freeAtUtc, "HH:mm")}")"
                                            Color="Color.Warning" />
                            }
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

    </MudGrid>
</MudStack>
