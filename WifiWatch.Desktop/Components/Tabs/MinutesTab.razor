@* Minutes Table *@
<DataTable TItem="MinuteSample"
           @ref="_minuteTable"
           ServerData="LoadMinutesAsync"
           @bind-SearchTerm="_searchTerm">

    <ToolBarExtra>
        @if (_focusStartUtc is not null)
        {
            @* Focus Chip *@
            <MudChip T="string"
                     Color="Color.Info"
                     Size="Size.Small"
                     Variant="Variant.Text"
                     OnClose="@(_ => ClearFocusAsync())">
                @FocusLabel
            </MudChip>
        }
        @* Export Menu *@
        <ExportMenu OnExport="ExportAsync" />
    </ToolBarExtra>

    <HeaderContent>
        <MudTh>
            <MudTableSortLabel T="MinuteSample"
                               SortLabel="@nameof(MinuteSample.MinuteUtc)"
                               InitialDirection="SortDirection.Descending">
                Time
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Link</MudTh>
        <MudTh>Network</MudTh>
        <MudTh>Channel</MudTh>
        <MudTh>
            <MudTableSortLabel T="MinuteSample"
                               SortLabel="@nameof(MinuteSample.Rssi)">
                Signal
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Rate</MudTh>
        <MudTh>
            <MudTableSortLabel T="MinuteSample"
                               SortLabel="@nameof(MinuteSample.RouterPingMilliseconds)">
                Router
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Jitter</MudTh>
        <MudTh>Loss</MudTh>
        <MudTh>
            <MudTableSortLabel T="MinuteSample"
                               SortLabel="@nameof(MinuteSample.InternetPingMilliseconds)">
                Internet
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Jitter</MudTh>
        <MudTh>Loss</MudTh>
        <MudTh>
            <MudTableSortLabel T="MinuteSample"
                               SortLabel="@nameof(MinuteSample.DnsMilliseconds)">
                DNS
            </MudTableSortLabel>
        </MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Time"
               Class="selectable-text">
            @Formatter.FormatLocal(context.MinuteUtc, "yyyy-MM-dd HH:mm")
        </MudTd>
        <MudTd DataLabel="Link">@context.Link</MudTd>
        <MudTd DataLabel="Network">@(context.Ssid ?? "-")</MudTd>
        <MudTd DataLabel="Channel">@FormatChannel(context.Channel)</MudTd>
        <MudTd DataLabel="Signal">@Formatter.FormatNumber(context.Rssi, "dBm")</MudTd>
        <MudTd DataLabel="Rate">@FormatRate(context)</MudTd>
        <MudTd DataLabel="Router">@Formatter.FormatNumber(context.RouterPingMilliseconds, "ms")</MudTd>
        <MudTd DataLabel="Jitter">@Formatter.FormatNumber(context.RouterJitterMilliseconds, "ms")</MudTd>
        <MudTd DataLabel="Loss">@($"{context.RouterLossPercent:0.#}%")</MudTd>
        <MudTd DataLabel="Internet">@Formatter.FormatNumber(context.InternetPingMilliseconds, "ms")</MudTd>
        <MudTd DataLabel="Jitter">@Formatter.FormatNumber(context.InternetJitterMilliseconds, "ms")</MudTd>
        <MudTd DataLabel="Loss">@($"{context.InternetLossPercent:0.#}%")</MudTd>
        <MudTd DataLabel="DNS">@Formatter.FormatNumber(context.DnsMilliseconds, "ms")</MudTd>
    </RowTemplate>

</DataTable>
