@* Events Table *@
<DataTable TItem="WifiEvent"
           @ref="_eventTable"
           ServerData="LoadEventsAsync"
           @bind-SearchTerm="_searchTerm"
           OnRowClick="OpenDetailsAsync">

    <ToolBarExtra>
        @* Filter Menu *@
        <FilterMenu TooltipText="Filter Kinds"
                    Options="s_kindOptions"
                    SelectedKeys="_selectedKinds"
                    OnToggle="ReloadAsync" />
        @* Export Menu *@
        <ExportMenu OnExport="ExportAsync" />
    </ToolBarExtra>

    <HeaderContent>
        <MudTh>
            <MudTableSortLabel T="WifiEvent"
                               SortLabel="@nameof(WifiEvent.OccurredAtUtc)"
                               InitialDirection="SortDirection.Descending">
                Time
            </MudTableSortLabel>
        </MudTh>
        <MudTh>Duration</MudTh>
        <MudTh>Kind</MudTh>
        <MudTh>Where</MudTh>
        <MudTh>Message</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Time"
               Class="selectable-text">
            @Formatter.FormatLocal(context.OccurredAtUtc, "yyyy-MM-dd HH:mm:ss")
        </MudTd>
        <MudTd DataLabel="Duration">@FormatDuration(context)</MudTd>
        <MudTd DataLabel="Kind">
            <ActionChip Text="@context.Kind.ToLabel()"
                        Color="@EventKindColors.For(context.Kind, context.Severity)"
                        Target="@QuickActions.ForEvent(context.Kind, Monitor.Status.RouterAdminUrl)" />
        </MudTd>
        <MudTd DataLabel="Where">@(context.Scope ?? "-")</MudTd>
        <MudTd DataLabel="Message"
               Class="selectable-text">
            <MudHighlighter Text="@context.Message"
                            HighlightedText="@_searchTerm" />
        </MudTd>
    </RowTemplate>

</DataTable>
