@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using WiFiWatch.Data.Localization

<MudStack Spacing="6">
    @* General Section *@
    <Header Title="@AppText.Get("General")"
            Icon="@Icons.Material.Rounded.Tune">
        <MudGrid Spacing="3">

            @* Start Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("StartWithWindows")"
                               Description="@AppText.Get("StartDescription")"
                               Value="Monitor.Settings.StartWithWindows"
                               ValueChanged="SaveStartWithWindows" />
            </MudItem>
            @* Summary Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("DailySummary")"
                               Description="@AppText.Get("SummaryDescription")"
                               Value="Monitor.Settings.DailySummaryNotification"
                               ValueChanged="value => SaveSettings(Monitor.Settings with { DailySummaryNotification = value })" />
            </MudItem>
            @* Speed Test Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("NightlySpeedTest")"
                               Description="@AppText.Get("SpeedDescription")"
                               Value="Monitor.Settings.NightlySpeedTest"
                               ValueChanged="value => SaveSettings(Monitor.Settings with { NightlySpeedTest = value })" />
            </MudItem>

        </MudGrid>
    </Header>

    @* Limits Section *@
    <Header Title="@AppText.Get("ProblemLimits")"
            Icon="@Icons.Material.Rounded.Rule"
            Info="@AppText.Get("LimitsDescription")">
        <MudGrid Spacing="3">

            @foreach (var limit in Limits)
            {
                @* Limit Card *@
                <MudItem xs="12"
                         md="4">
                    <MudPaper Elevation="4"
                              Class="pa-4 rounded-panel mud-height-full">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2"
                                     Class="d-inline-flex align-center">
                                @AppText.Get(limit.TitleKey)
                                <InfoIcon Text="@AppText.Get(limit.InfoKey)" />
                            </MudText>
                            <NumberField T="int"
                                         Value="limit.Value"
                                         ValueChanged="value => SaveSettings(limit.With(value))"
                                         Min="limit.Min"
                                         Max="limit.Max"
                                         Margin="Margin.Dense"
                                         Class="fixed-width" />
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }

        </MudGrid>
    </Header>

    @* Adapter Section *@
    @if (Monitor.Adapter is { } adapter)
    {
        <Header Title="@AppText.Get("WiFiAdapter")"
                Icon="@Icons.Material.Rounded.Router">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                @* Adapter Chips *@
                <MudStack Row
                          Wrap="Wrap.Wrap"
                          Spacing="1">
                    <ActionChip Icon="@Icons.Material.Rounded.Memory"
                                Text="@adapter.Name"
                                Target="@QuickActions.DeviceManager" />
                    <ActionChip Icon="@Icons.Material.Rounded.Update"
                                Text="@DriverText(adapter)"
                                Color="@DriverColor(adapter)"
                                Target="@(adapter.IsDriverOld ? QuickActions.WindowsUpdate : null)" />
                    <ActionChip Icon="@Icons.Material.Rounded.Power"
                                Text="@AppText.Get("PluggedIn", AppText.Get(adapter.PowerSavingOnPower ?? "-"))"
                                Color="@PowerColor(adapter.PowerSavingOnPower)" />
                    <ActionChip Icon="@Icons.Material.Rounded.BatteryStd"
                                Text="@AppText.Get("OnBattery", AppText.Get(adapter.PowerSavingOnBattery ?? "-"))" />
                    @if (adapter.Roaming is { } roaming)
                    {
                        <ActionChip Icon="@Icons.Material.Rounded.SettingsInputAntenna"
                                    Text="@AppText.Get("Roaming", roaming)" />
                    }
                </MudStack>
            </MudPaper>
        </Header>
    }
</MudStack>
