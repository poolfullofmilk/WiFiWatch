@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using WiFiWatch.Data.Localization

<MudStack Spacing="6">
    @* General Section, One Card Per Setting Straight On The Page *@
    <Header Title="@AppText.Get("General")">
        <MudGrid Spacing="3">
            @* Language *@
            <MudItem xs="12"
                     md="4">
                <MudPaper Elevation="4"
                          Class="pa-4 rounded-panel mud-height-full">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2"
                                 Class="d-inline-flex align-center">
                            @AppText.Get("Language")
                            <InfoIcon Text="@AppText.Get("LanguageDescription")" />
                        </MudText>
                        <MudSelect T="string"
                                   Value="@SelectedLanguage"
                                   ValueChanged="SaveLanguage"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense>
                            <MudSelectItem T="string" Value="@(string.Empty)">@AppText.Get("SystemLanguage")</MudSelectItem>
                            @foreach (var language in AppText.Languages)
                            {
                                <MudSelectItem T="string" Value="@language.Key">@language.Value</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>
                </MudPaper>
            </MudItem>
            @* Start Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("StartWithWindows")"
                               Description="@AppText.Get("StartDescription")"
                               Value="Monitor.Settings.StartWithWindows"
                               ValueChanged="SaveStartWithWindows" />
            </MudItem>
            @* Summary Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("DailySummary")"
                               Description="@AppText.Get("SummaryDescription")"
                               Value="Monitor.Settings.DailySummaryNotification"
                               ValueChanged="value => SaveSettings(Monitor.Settings with { DailySummaryNotification = value })" />
            </MudItem>
            @* Speed Test Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("NightlySpeedTest")"
                               Description="@AppText.Get("SpeedDescription")"
                               Value="Monitor.Settings.NightlySpeedTest"
                               ValueChanged="value => SaveSettings(Monitor.Settings with { NightlySpeedTest = value })" />
            </MudItem>
            @* Native Wi-Fi Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("NativeWiFi")"
                               Description="@AppText.Get("NativeDescription")"
                               Value="Monitor.Settings.ReadWiFiNatively"
                               ValueChanged="value => SaveSettings(Monitor.Settings with { ReadWiFiNatively = value })" />
            </MudItem>
            @* Update Popup Switch *@
            <MudItem xs="12"
                     md="4">
                <SettingSwitch Title="@AppText.Get("UpdatePopup")"
                               Description="@AppText.Get("UpdateDescription")"
                               Value="Monitor.Settings.ShowUpdatePopup"
                               ValueChanged="value => SaveSettings(Monitor.Settings with { ShowUpdatePopup = value })" />
            </MudItem>
        </MudGrid>
    </Header>

    @* Limits Section *@
    <Header Title="@AppText.Get("ProblemLimits")"
            Info="@AppText.Get("LimitsDescription")">
        <MudGrid Spacing="3">
            @* Weak Signal *@
            <MudItem xs="12"
                     md="4">
                <MudPaper Elevation="4"
                          Class="pa-4 rounded-panel mud-height-full">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2"
                                 Class="d-inline-flex align-center">
                            @AppText.Get("WeakSignal")
                            <InfoIcon Text="@AppText.Get("SignalDescription")" />
                        </MudText>
                        <NumberField T="int"
                                     Value="Monitor.Settings.WeakSignalRssi"
                                     ValueChanged="value => SaveSettings(Monitor.Settings with { WeakSignalRssi = value })"
                                     Min="-100"
                                     Max="-30"
                                     Margin="Margin.Dense"
                                     Class="fixed-width" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            @* Router Ping *@
            <MudItem xs="12"
                     md="4">
                <MudPaper Elevation="4"
                          Class="pa-4 rounded-panel mud-height-full">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2"
                                 Class="d-inline-flex align-center">
                            @AppText.Get("RouterPing")
                            <InfoIcon Text="@AppText.Get("RouterDescription")" />
                        </MudText>
                        <NumberField T="int"
                                     Value="Monitor.Settings.RouterPingMilliseconds"
                                     ValueChanged="value => SaveSettings(Monitor.Settings with { RouterPingMilliseconds = value })"
                                     Min="1"
                                     Max="1000"
                                     Margin="Margin.Dense"
                                     Class="fixed-width" />
                    </MudStack>
                </MudPaper>
            </MudItem>
            @* Internet Ping *@
            <MudItem xs="12"
                     md="4">
                <MudPaper Elevation="4"
                          Class="pa-4 rounded-panel mud-height-full">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2"
                                 Class="d-inline-flex align-center">
                            @AppText.Get("InternetPing")
                            <InfoIcon Text="@AppText.Get("InternetDescription")" />
                        </MudText>
                        <NumberField T="int"
                                     Value="Monitor.Settings.InternetPingMilliseconds"
                                     ValueChanged="value => SaveSettings(Monitor.Settings with { InternetPingMilliseconds = value })"
                                     Min="1"
                                     Max="2000"
                                     Margin="Margin.Dense"
                                     Class="fixed-width" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </Header>

    @* Adapter Section *@
    @if (Monitor.Adapter is { } adapter)
    {
        <Header Title="@AppText.Get("WiFiAdapter")">
            <MudPaper Elevation="4"
                      Class="pa-4 rounded-panel">
                @* Adapter Chips *@
                <MudStack Row
                          Wrap="Wrap.Wrap"
                          Spacing="1">
                    <ActionChip Icon="@Icons.Material.Rounded.Memory"
                                Text="@adapter.Name"
                                Target="@QuickActions.DeviceManager" />
                    <ActionChip Icon="@Icons.Material.Rounded.Update"
                                Text="@DriverText(adapter)"
                                Color="@DriverColor(adapter)"
                                Target="@(adapter.IsDriverOld ? QuickActions.WindowsUpdate : null)" />
                    <ActionChip Icon="@Icons.Material.Rounded.Power"
                                Text="@AppText.Get("PluggedIn", AppText.Get(adapter.PowerSavingOnPower ?? "-"))"
                                Color="@PowerColor(adapter.PowerSavingOnPower)" />
                    <ActionChip Icon="@Icons.Material.Rounded.BatteryStd"
                                Text="@AppText.Get("OnBattery", AppText.Get(adapter.PowerSavingOnBattery ?? "-"))" />
                    @if (adapter.Roaming is { } roaming)
                    {
                        <ActionChip Icon="@Icons.Material.Rounded.SettingsInputAntenna"
                                    Text="@AppText.Get("Roaming", roaming)" />
                    }
                </MudStack>
            </MudPaper>
        </Header>
    }

    @* About Section *@
    <Header Title="@AppText.Get("About")">
        <MudPaper Elevation="4"
                  Class="pa-4 rounded-panel">
            @* Version Row *@
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @AppText.Get("AppName") @AppInfo.VersionText
                </MudText>
                @if (Monitor.AvailableUpdate is { } availableUpdate)
                {
                    <ActionChip Icon="@Icons.Material.Rounded.NewReleases"
                                Text="@AppText.Get("VersionAvailable", AppInfo.ShortText(availableUpdate))"
                                Color="Color.Info"
                                Target="@UpdateChecker.LatestReleaseUrl" />
                    <MudSpacer />
                    @* Update Button, The Same Dialog As The Popup *@
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.SystemUpdateAlt"
                               OnClick="() => UpdateDialog.ShowAsync(DialogService, availableUpdate)">
                        @AppText.Get("UpdateNow")
                    </MudButton>
                }
                else
                {
                    <MudSpacer />
                    @* Check Button *@
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Rounded.Refresh"
                               Disabled="_isChecking"
                               OnClick="CheckForUpdateAsync">
                        @AppText.Get("CheckUpdates")
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </Header>
</MudStack>
