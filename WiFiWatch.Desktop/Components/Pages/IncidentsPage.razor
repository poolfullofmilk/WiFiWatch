@using Size = MudBlazor.Size

@* Incidents, Title And Actions On One Row, The Table Ends On The Bottom Gutter *@
<Header Title="@AppText.Get("Incidents")"
        Class="page-fill">
    <TitleContent>
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2">
            @* Search, Inset Like Every Field, Its Value Arrives Once Typing Pauses *@
            <MudTextField T="string"
                          Value="_searchTerm"
                          ValueChanged="SearchAsync"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Placeholder="@AppText.Get("Search")"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Rounded.Search"
                          DebounceInterval="300"
                          Clearable
                          ClearIcon="@Icons.Material.Rounded.Clear"
                          Class="fixed-width my-0" />
            @* Scope Buttons *@
            <SegmentedButtonGroup TValue="bool"
                                  Options="ScopeOptions"
                                  Value="_isEverything"
                                  ValueChanged="SelectScopeAsync" />
            @* Export Menu *@
            <ExportMenu OnExport="ExportAsync" />
            @* Refresh *@
            <Tooltip Text="@AppText.Get("Refresh")">
                <MudIconButton aria-label="@AppText.Get("Refresh")"
                               Icon="@Icons.Material.Rounded.Refresh"
                               Size="Size.Small"
                               OnClick="ReloadAsync" />
            </Tooltip>
        </MudStack>
    </TitleContent>
    <ChildContent>
        <DataTable TItem="WiFiEvent"
                   @ref="_incidentTable"
                   ServerData="LoadIncidentsAsync"
                   OnRowClick="OpenDetailsAsync">

            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="WiFiEvent"
                                       SortLabel="@nameof(WiFiEvent.OccurredAtUtc)"
                                       InitialDirection="SortDirection.Descending"
                                       SortIcon="@Icons.Material.Rounded.ArrowUpward">
                        @AppText.Get("When")
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>@AppText.Get("What")</MudTh>
                <MudTh>@AppText.Get("Where")</MudTh>
                <MudTh>@AppText.Get("Length")</MudTh>
                <MudTh>@AppText.Get("Details")</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="@AppText.Get("When")"
                       Class="selectable-text">
                    @Formatter.FormatLocal(context.OccurredAtUtc, Formatter.DateTimeFormat)
                </MudTd>
                <MudTd DataLabel="@AppText.Get("What")">
                    <MudChip T="string"
                             Icon="@EventKindColors.IconFor(context.Severity)"
                             Color="@EventKindColors.For(context.Kind, context.Severity)"
                             Size="Size.Small"
                             Variant="Variant.Text">
                        @context.Kind.ToLabel()
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@AppText.Get("Where")">
                    <MudHighlighter Text="@(context.Scope is { } scope ? AppText.Get(scope) : "-")"
                                    HighlightedText="@_searchTerm" />
                </MudTd>
                <MudTd DataLabel="@AppText.Get("Length")">@(Formatter.FormatIncidentLength(context.OccurredAtUtc, context.EndedAtUtc) ?? "-")</MudTd>
                <MudTd DataLabel="@AppText.Get("Details")"
                       Class="selectable-text">
                    <MudHighlighter Text="@context.Message"
                                    HighlightedText="@_searchTerm" />
                </MudTd>
            </RowTemplate>

        </DataTable>
    </ChildContent>
</Header>
