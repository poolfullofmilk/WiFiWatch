@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

@* Providers *@
<MudThemeProvider Theme="AppTheme.Custom"
                  IsDarkMode />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false"
                   MaxWidth="MaxWidth.False" />
<MudSnackbarProvider />

@* Close Message Box *@
<MudMessageBox @ref="_closeMessageBox"
               Title="@(AppText.Get("Close {0}", AppInfo.DisplayName))">
    <MessageContent>
        @AppText.Get("Keep Watching From The Tray Or Exit Completely")
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.PowerSettingsNew">
            @AppText.Get("Exit")
        </MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Rounded.Check">
            @AppText.Get("Keep Running")
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudLayout>
    <MudAppBar Elevation="4"
               Style="background-color:color-mix(in srgb, var(--mud-palette-appbar-background) var(--glass-opacity), transparent); backdrop-filter:var(--glass-blur)">
        <MudText Typo="Typo.h6"
                 Class="mx-2">
            @AppInfo.DisplayName
        </MudText>
        <MudSpacer />
        @* Page Menu *@
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="1">
            @foreach (var link in Pages)
            {
                @* Page Button *@
                <MudBadge Dot
                          Overlap
                          Visible="@(link.Page == Page.Overview && _problemColor is not null)"
                          Color="@(_problemColor ?? Color.Default)">
                    <MudButton StartIcon="@link.Icon"
                               Color="@(link.Page == _page ? Color.Secondary : Color.Default)"
                               Variant="@(link.Page == _page ? Variant.Filled : Variant.Text)"
                               Size="Size.Small"
                               Class="px-3"
                               OnClick="() => ShowPage(link.Page)">
                        @link.Label
                    </MudButton>
                </MudBadge>
            }
        </MudStack>
    </MudAppBar>

    @* Main Content *@
    <MudMainContent @key="_languageVersion" Class="px-7 pb-7 pt-20">
        <MudContainer MaxWidth="MaxWidth.Large"
                      Gutters="false">
            @switch (_page)
            {
                case Page.Overview:
                    <OverviewPage IncidentsRequested="() => ShowPage(Page.Incidents)" />
                    break;
                case Page.Incidents:
                    <IncidentsPage />
                    break;
                case Page.History:
                    <HistoryPage />
                    break;
                default:
                    <SettingsPage />
                    break;
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>
