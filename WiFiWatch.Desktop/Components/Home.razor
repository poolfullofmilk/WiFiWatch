@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@using WiFiWatch.Services.Integration

@* Providers *@
<MudThemeProvider Theme="AppTheme.Custom"
                  IsDarkMode
                  DefaultScrollbar />
<MudPopoverProvider />
<MudDialogProvider BackdropClick="false"
                   CloseButton="true"
                   CloseOnEscapeKey="true"
                   MaxWidth="MaxWidth.False" />
<MudSnackbarProvider />

@* Scroll To Top *@
<MudScrollToTop>
    <MudFab Color="Color.Info"
            Size="Size.Small"
            StartIcon="@Icons.Material.Rounded.ArrowUpward"
            aria-label="@AppText.Get("Scroll To Top")"
            title="@AppText.Get("Scroll To Top")" />
</MudScrollToTop>

@* Close Message Box *@
<MudMessageBox @ref="_closeMessageBox"
               Title="@(AppText.Get("Close {0}", AppInfo.DisplayName))">
    <MessageContent>
        @AppText.Get("Keep Watching From The Tray Or Exit Completely")
    </MessageContent>
    <NoButton>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Rounded.PowerSettingsNew">
            @AppText.Get("Exit")
        </MudButton>
    </NoButton>
    <YesButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Rounded.Check">
            @AppText.Get("Keep Running")
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudLayout>
    <MudAppBar Elevation="4"
               Style="background-color:color-mix(in srgb, var(--mud-palette-appbar-background) var(--glass-opacity), transparent); backdrop-filter:var(--glass-blur)">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="mud-width-full px-2">
            <MudText Typo="Typo.h6"
                     Class="mud-typography-nowrap mr-4">
                @AppInfo.DisplayName
            </MudText>

            @* Language Menu *@
            <LanguagePicker />

            @* Help Menu *@
            <Tooltip Text="@AppText.Get("Help")"
                     RootClass="d-flex">
                <MudBadge Dot
                          Overlap
                          Color="Color.Error"
                          Visible="@(Monitor.AvailableUpdate is not null)"
                          Class="d-flex">
                    <MudMenu Icon="@Icons.Material.Rounded.Help"
                             AriaLabel="@AppText.Get("Help")"
                             Size="Size.Small"
                             Dense
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft">
                        @* Project Page *@
                        <MudMenuItem Icon="@Icons.Custom.Brands.GitHub"
                                     Label="@AppText.Get("GitHubProject")"
                                     Href="@UpdateChecker.RepositoryUrl" />
                        @* Check Updates *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.SystemUpdateAlt"
                                     Label="@AppText.Get("CheckUpdates")"
                                     Class="@(Monitor.AvailableUpdate is null ? null : "update-dot")"
                                     OnClick="CheckForUpdatesAsync" />
                        <MudDivider />
                        @* About *@
                        <MudMenuItem Icon="@Icons.Material.Rounded.Info"
                                     Label="@AppText.Get("About")"
                                     OnClick="ShowAboutAsync" />
                    </MudMenu>
                </MudBadge>
            </Tooltip>

            <MudSpacer />
            @foreach (var link in Pages)
            {
                @* Page Button *@
                <MudBadge Dot
                          Overlap
                          Class="d-flex"
                          Visible="@(link.Page == Page.Overview && _problemColor is not null)"
                          Color="@(_problemColor ?? Color.Default)">
                    <MudButton StartIcon="@link.Icon"
                               Color="@(link.Page == _page ? Color.Info : Color.Default)"
                               Variant="@(link.Page == _page ? Variant.Filled : Variant.Text)"
                               Size="Size.Small"
                               Class="px-3"
                               OnClick="() => ShowPage(link.Page)">
                        @link.Label
                    </MudButton>
                </MudBadge>
            }
        </MudStack>
    </MudAppBar>

    @* Main Content *@
    <MudMainContent @key="_languageVersion"
                    Class="px-7 pb-7 pt-20">
        <MudContainer MaxWidth="MaxWidth.Large"
                      Gutters="false">
            <PageErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @switch (_page)
                    {
                        case Page.Overview:
                            <OverviewPage IncidentsRequested="() => ShowPage(Page.Incidents)" />
                            break;
                        case Page.Incidents:
                            <IncidentsPage />
                            break;
                        case Page.History:
                            <HistoryPage />
                            break;
                        default:
                            <SettingsPage />
                            break;
                    }
                </ChildContent>
                <ErrorContent Context="exception">
                    @* Page Error *@
                    <MudStack AlignItems="AlignItems.Center"
                              Spacing="4"
                              Class="pa-8">
                        <MudIcon Icon="@Icons.Material.Rounded.Error"
                                 Color="Color.Error"
                                 Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1"
                                 Class="mud-text-secondary">
                            @AppText.Get("App Failed {0}", exception.GetType().Name)
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   OnClick="() => _errorBoundary!.Recover()">
                            @AppText.Get("OK")
                        </MudButton>
                    </MudStack>
                </ErrorContent>
            </PageErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>
