@* Incident Dialog *@
<MudDialog>

    <TitleContent>
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="3">
            <MudIcon Icon="@EventKindColors.IconFor(Current.Severity)"
                     Color="@EventKindColors.For(Current.Kind, Current.Severity)" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Current.Kind.ToLabel()</MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @TimeRange
                </MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4"
                  Style="max-width:720px">
            <MudText Typo="Typo.body1"
                     Class="selectable-text">
                @Current.Message
            </MudText>
            @if (DetailLines.Count > 0)
            {
                @* Detail Table *@
                <MudSimpleTable Dense
                                Outlined
                                Elevation="0"
                                Class="rounded-inner">
                    <tbody>
                        @foreach (var (label, value) in DetailLines)
                        {
                            <tr>
                                <td class="mud-text-secondary">@label</td>
                                <td class="selectable-text">@value</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            @if (Details.Trace is { Count: > 0 } hops)
            {
                @* Trace Table *@
                <MudSimpleTable Dense
                                Outlined
                                Elevation="0"
                                Class="rounded-inner">
                    <thead>
                        <tr>
                            <th>@AppText.Get("Hop")</th>
                            <th>@AppText.Get("Address")</th>
                            <th>@AppText.Get("Name")</th>
                            <th>@AppText.Get("Loss")</th>
                            <th>@AppText.Get("Average")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hop in hops)
                        {
                            <tr>
                                <td>@hop.Number</td>
                                <td>@(hop.Address ?? AppText.Get("No Answer"))</td>
                                <td>@(hop.Name ?? "-")</td>
                                <td>@($"{hop.LossPercent:0}%")</td>
                                <td>@Formatter.FormatNumber(hop.AverageMilliseconds, "ms")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (FixTarget is { } fixTarget)
        {
            @* Fix Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Build"
                       OnClick="() => QuickActions.Open(fixTarget)">
                @QuickActions.Describe(fixTarget)
            </MudButton>
        }
    </DialogActions>

</MudDialog>
