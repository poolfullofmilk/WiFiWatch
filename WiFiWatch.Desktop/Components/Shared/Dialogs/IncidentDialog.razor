@* Incident Dialog *@
<MudDialog>

    <TitleContent>
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Spacing="3">
            <MudIcon Icon="@EventKindColors.IconFor(Current.Severity)"
                     Color="@EventKindColors.For(Current.Kind, Current.Severity)" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Current.Kind.ToLabel()</MudText>
                <MudText Typo="Typo.body2"
                         Class="mud-text-secondary">
                    @TimeRange
                </MudText>
            </MudStack>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4"
                  Style="max-width:720px">
            <MudText Typo="Typo.body1"
                     Class="selectable-text">
                @Current.Message
            </MudText>
            @if (DetailLines.Count > 0)
            {
                @* Details *@
                <MudPaper Elevation="0"
                          Class="inset rounded-panel pa-4">
                    <MudGrid Spacing="3">

                        @foreach (var (label, value) in DetailLines)
                        {
                            <MudItem xs="12"
                                     sm="6">
                                <MudText Typo="Typo.caption"
                                         Class="mud-text-secondary">
                                    @label
                                </MudText>
                                <MudText Typo="Typo.body2"
                                         Class="selectable-text">
                                    @value
                                </MudText>
                            </MudItem>
                        }

                    </MudGrid>
                </MudPaper>
            }
            @if (Details.Trace is { Count: > 0 } hops)
            {
                @* Trace Table *@
                <MudTable T="TraceHop"
                          Items="hops"
                          Dense
                          Hover
                          FixedHeader
                          Elevation="0"
                          Class="fit fixed-columns"
                          Style="max-height:40vh">

                    <ColGroup>
                        <col style="width:56px" />
                        <col style="width:140px" />
                        <col />
                        <col style="width:72px" />
                        <col style="width:96px" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>@AppText.Get("Hop")</MudTh>
                        <MudTh>@AppText.Get("Address")</MudTh>
                        <MudTh>@AppText.Get("Name")</MudTh>
                        <MudTh>@AppText.Get("Loss")</MudTh>
                        <MudTh>@AppText.Get("Average")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Number</MudTd>
                        <MudTd Class="selectable-text mud-typography-nowrap">@(context.Address ?? AppText.Get("No Answer"))</MudTd>
                        <MudTd Class="selectable-text mud-typography-nowrap"
                               title="@context.Name">
                            @(context.Name ?? "-")
                        </MudTd>
                        <MudTd>@($"{context.LossPercent:0}%")</MudTd>
                        <MudTd>@Formatter.FormatNumber(context.AverageMilliseconds, "ms")</MudTd>
                    </RowTemplate>

                </MudTable>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (FixTarget is { } fixTarget)
        {
            @* Fix Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Rounded.Build"
                       OnClick="() => QuickActions.Open(fixTarget)">
                @QuickActions.Describe(fixTarget)
            </MudButton>
        }
    </DialogActions>

</MudDialog>
