@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

@* Update Dialog *@
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            @(AppText.Get("Version {0} Available", Version.ToString(2)))
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body1">
                @(AppText.Get("Installed Version Is {0}, Updating Restarts {1}", AppInfo.Version.ToString(2), AppInfo.DisplayName))
            </MudText>
            @* Hide Checkbox *@
            <MudCheckBox T="bool"
                         Value="!Monitor.Settings.ShowUpdatePopup"
                         ValueChanged="SetHidden"
                         Label="@AppText.Get("Don't Show Again")"
                         Color="Color.Info"
                         CheckedIcon="@Icons.Material.Rounded.CheckBox"
                         UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudStack Row
                  Justify="Justify.SpaceBetween"
                  Spacing="4"
                  Class="px-3 py-2 mud-width-full">
            @* Later Button *@
            <MudButton Variant="Variant.Filled"
                       Size="Size.Small"
                       OnClick="Close">
                @AppText.Get("Later")
            </MudButton>
            @* Update Button *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       Size="Size.Small"
                       StartIcon="@(_isInstalling ? null : Icons.Material.Rounded.SystemUpdateAlt)"
                       OnClick="InstallAsync">
                @if (_isInstalling)
                {
                    <MudProgressCircular Color="Color.Inherit"
                                         Indeterminate
                                         Class="mr-2"
                                         Style="width:16px; height:16px" />
                }
                @(_isInstalling ? AppText.Get("Downloading") : AppText.Get("Update Now"))
            </MudButton>
        </MudStack>
    </DialogActions>

</MudDialog>
