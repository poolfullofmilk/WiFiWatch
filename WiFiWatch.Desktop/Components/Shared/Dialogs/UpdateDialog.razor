@using Color = MudBlazor.Color
@using Size = MudBlazor.Size

@* Update Dialog *@
<MudDialog>

    <TitleContent>
        <MudText Typo="Typo.h6">
            @(AppText.Get("Version {0} Available", AppInfo.ShortText(Version)))
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body1">
                @(AppText.Get("Installed Version Is {0}, Updating Restarts {1}", AppInfo.VersionText, AppInfo.DisplayName))
            </MudText>
            @* What Changed, Commit Titles As GitHub Supplies Them *@
            @if (Monitor.UpdateNotes.Count > 0)
            {
                <MudText Typo="Typo.subtitle2">@AppText.Get("What Changed")</MudText>
                <MudStack Spacing="1">
                    @foreach (var note in Monitor.UpdateNotes)
                    {
                        <MudStack Row
                                  AlignItems="AlignItems.Start"
                                  Spacing="2">
                            <MudIcon Icon="@Icons.Material.Rounded.CheckCircle"
                                     Color="Color.Info"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2">@note</MudText>
                        </MudStack>
                    }
                </MudStack>
            }
            @* Hide Checkbox *@
            <MudCheckBox T="bool"
                         Value="!Monitor.Settings.ShowUpdatePopup"
                         ValueChanged="SetHidden"
                         Label="@AppText.Get("Don't Show Again")"
                         Color="Color.Info"
                         CheckedIcon="@Icons.Material.Rounded.CheckBox"
                         UncheckedIcon="@Icons.Material.Rounded.CheckBoxOutlineBlank" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* Update Button *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@(_isInstalling ? null : Icons.Material.Rounded.SystemUpdateAlt)"
                   OnClick="InstallAsync">
            @if (_isInstalling)
            {
                <MudProgressCircular Color="Color.Inherit"
                                     Indeterminate
                                     Class="mr-2"
                                     Style="width:16px; height:16px" />
            }
            @(_isInstalling ? AppText.Get("Downloading") : AppText.Get("Update Now"))
        </MudButton>
    </DialogActions>

</MudDialog>
