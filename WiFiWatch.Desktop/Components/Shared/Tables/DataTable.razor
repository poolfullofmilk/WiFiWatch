@typeparam TItem

<MudTable @ref="_mudTable"
          T="TItem"
          ServerData="ServerDataWrapper"
          SortLabel="@AppText.Get("Sort By")"
          Dense
          Hover
          AllowUnsorted="false"
          Elevation="4"
          RowsPerPage="@_rowsPerPage"
          FixedHeader
          Class="rounded-panel fit"
          OnRowClick="OnRowClick"
          RowClass="@(OnRowClick.HasDelegate ? "cursor-pointer" : null)">

    @* ToolBar *@
    <ToolBarContent>
        @* Search *@
        @* Search, Inset Like Every Field, Its Value Arrives Once Typing Pauses *@
        <MudTextField T="string"
                      Value="SearchTerm"
                      ValueChanged="OnSearchTermChangedAsync"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Placeholder="@AppText.Get("Search")"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Rounded.Search"
                      DebounceInterval="300"
                      Clearable
                      ClearIcon="@Icons.Material.Rounded.Clear"
                      Class="fixed-width my-0" />

        <MudSpacer />

        <MudStack Row
                  Spacing="3"
                  AlignItems="AlignItems.Center"
                  Class="px-4">
            @* Extra *@
            @if (ToolBarExtra is not null)
            {
                @ToolBarExtra
            }
            @* Refresh *@
            <Tooltip Text="@AppText.Get("Refresh")">
                <MudIconButton aria-label="@AppText.Get("Refresh")"
                               Icon="@Icons.Material.Rounded.Refresh"
                               Size="Size.Small"
                               OnClick="ReloadAsync" />
            </Tooltip>
        </MudStack>
    </ToolBarContent>

    @* Header *@
    <HeaderContent>
        @HeaderContent
    </HeaderContent>

    @* Row *@
    <RowTemplate>
        @RowTemplate(context)
    </RowTemplate>

    @* Empty *@
    <NoRecordsContent>
        <MudText Typo="Typo.body2"
                 Class="mud-text-secondary">
            @AppText.Get("Nothing Found")
        </MudText>
    </NoRecordsContent>

    @* Pager *@
    <PagerContent>
        <MudTablePager HorizontalAlignment="HorizontalAlignment.Center"
                       PageSizeOptions="new int[] { 50, 100, int.MaxValue }"
                       RowsPerPageString="@AppText.Get("Rows Per Page")"
                       InfoFormat="@AppText.Get("MudPagerInfo")"
                       AllItemsText="@AppText.Get("All")"
                       FirstIcon="@Icons.Material.Rounded.FirstPage"
                       BeforeIcon="@Icons.Material.Rounded.NavigateBefore"
                       NextIcon="@Icons.Material.Rounded.NavigateNext"
                       LastIcon="@Icons.Material.Rounded.LastPage" />
    </PagerContent>

</MudTable>
