@typeparam TValue

@* Button Group *@
<MudButtonGroup Size="Size.Small"
                Style="border-radius:var(--mud-default-borderradius)"
                OverrideStyles="false">
    @foreach (var option in Options)
    {
        @* Option Button *@
        <MudButton Variant="Variant.Filled"
                   Color="@(IsSelected(option.Value) ? Color.Info : Color.Default)"
                   Size="Size.Small"
                   OnClick="@(() => SelectAsync(option.Value))">
            @option.Label
        </MudButton>
    }
</MudButtonGroup>
