@* Setting Card *@
<MudPaper Elevation="4"
          Class="pa-4 rounded-panel mud-height-full d-flex align-center">
    <MudSwitch T="bool"
               Value="Value"
               ValueChanged="ValueChanged"
               Color="Color.Info"
               Class="ma-0">
        <MudText Typo="Typo.subtitle2"
                 HtmlTag="span"
                 Class="d-inline-flex align-center">
            @Title
            @if (Description is not null)
            {
                <InfoIcon Text="@Description" />
            }
        </MudText>
    </MudSwitch>
</MudPaper>
