<MudStack Spacing="2"
          Class="@Class">
    @* Header, Actions Keep One Line While The Title Gives Way *@
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Class="header-row">
        <MudText Typo="Typo.h5"
                 Class="@(Info is null ? "header-title mx-2" : "header-title ml-2")">
            @Title
        </MudText>
        @if (Info is not null)
        {
            <InfoIcon Text="@Info" />
        }
        <MudSpacer />
        @TitleContent
    </MudStack>

    @ChildContent
</MudStack>
