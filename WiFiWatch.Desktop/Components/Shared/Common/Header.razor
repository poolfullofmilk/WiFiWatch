<MudStack Spacing="2"
          Class="@Class">
    @* Header, Actions Keep One Line While The Title Gives Way *@
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1"
              Class="header-row">
        @if (Icon is not null)
        {
            <MudIcon Icon="@Icon"
                     Color="Color.Tertiary"
                     Class="ml-2 mr-1" />
        }
        <MudText Typo="Typo.h5"
                 Class="@($"header-title {(Icon is null ? "ml-2" : "")} {(Info is null ? "mr-2" : "")}")">
            @Title
        </MudText>
        @if (Info is not null)
        {
            <InfoIcon Text="@Info" />
        }
        <MudSpacer />
        @TitleContent
    </MudStack>

    @ChildContent
</MudStack>
