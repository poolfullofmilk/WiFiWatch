<MudStack Spacing="2">
    @* Header *@
    <MudStack Row
              AlignItems="AlignItems.Center"
              Spacing="1">
        <MudText Typo="Typo.h5"
                 Class="@(Info is null ? "mx-2" : "ml-2")">
            @Title
        </MudText>
        @if (Info is not null)
        {
            @* Info Icon *@
            <Tooltip Text="@Info"
                     RootClass="d-inline-flex ml-1 info-icon">
                <MudIcon Icon="@Icons.Material.Rounded.Info"
                         Color="Color.Info"
                         Size="Size.Small" />
            </Tooltip>
        }
        <MudSpacer />
        @TitleContent
    </MudStack>

    @ChildContent
</MudStack>
