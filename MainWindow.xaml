<Window
    x:Class="WifiWatch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
    xmlns:components="clr-namespace:WifiWatch.Components"
    xmlns:local="clr-namespace:WifiWatch"
    Title="{x:Static local:App.DisplayName}"
    Width="1280"
    Height="800"
    MinWidth="800"
    MinHeight="500"
    Background="#202020"
    WindowStartupLocation="CenterScreen"
>
    <!-- BlazorWebView -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type components:Home}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
